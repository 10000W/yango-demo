{
  "name": "@tac-crypto-payment/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TAC crypto payments through PayZap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10000W/yango-demo.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/10000W/yango-demo/issues"
  },
  "homepage": "https://github.com/10000W/yango-demo#readme",
  "keywords": [
    "payments",
    "crypto",
    "web3",
    "evm",
    "tron"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/payzap": {
      "types": "./dist/adapters/payzap.d.ts",
      "import": "./dist/adapters/payzap.js",
      "default": "./dist/adapters/payzap.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && npm run type-check"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "peerDependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-tron": "^1.8.23",
    "tronweb": "^6.5.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
