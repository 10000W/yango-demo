{
  "name": "@tac-crypto-payment/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TAC crypto payments through PayZap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10000W/yango-demo.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/10000W/yango-demo/issues"
  },
  "homepage": "https://github.com/10000W/yango-demo#readme",
  "keywords": [
    "payments",
    "crypto",
    "web3",
    "evm",
    "tron"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/payzap": {
      "types": "./dist/adapters/payzap/index.d.ts",
      "development": "./src/adapters/payzap/index.ts",
      "import": "./dist/adapters/payzap/index.js",
      "default": "./dist/adapters/payzap/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && npm run type-check"
  },
  "dependencies": {
    "axios": "catalog:workspace"
  },
  "peerDependencies": {
    "@reown/appkit": "catalog:workspace",
    "@reown/appkit-adapter-tron": "catalog:workspace",
    "tronweb": "catalog:workspace",
    "viem": "catalog:workspace"
  },
  "devDependencies": {
    "typescript": "catalog:workspace",
    "vite": "catalog:vite",
    "vite-plugin-dts": "catalog:vite",
    "vitest": "catalog:vite"
  }
}
