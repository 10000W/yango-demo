{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@tac-crypto-payment/runtime": [
        "../runtime/src/index.ts"
      ],
      "@/*": [
        "src/*",
        "../runtime/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../runtime/src/**/*"
  ]
}
